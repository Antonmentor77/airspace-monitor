# OpenSky Network (необязательно — без этого работает анонимно, лимит ~400 req/день)
# Зарегистрироваться: https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# RapidAPI / SkyLink для NOTAMов (1000 req/мес бесплатно)
# Зарегистрироваться: https://rapidapi.com/skylink-api
RAPIDAPI_KEY=

# RSSHub — для парсинга Telegram (оставить пустым = используем публичный rsshub.app)
# Или self-hosted: https://github.com/DIYgod/RSSHub
RSSHUB_URL=

# Порт сервера
PORT=3001
